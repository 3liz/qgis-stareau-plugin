              <rule symbol="4" filter="&quot;type_regard&quot; ='mixte'" key="{b92c459b-7f84-4572-b3c3-9fd0da5a431e}" label="regard mixte" description="regard où passe eaux usées et pluviales sans se mélanger"/>
