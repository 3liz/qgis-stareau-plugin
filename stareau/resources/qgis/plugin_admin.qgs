          <rule key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" description="Conduite en service ou arrêt momentané" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" label="En service">
            <rule scalemaxdenom="110000" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" symbol="0" scalemindenom="2001" label="Vue d'ensemble"/>
            <rule scalemaxdenom="2000" key="{12476d89-e51c-44f4-b989-88588868e278}" label="Détails">
              <rule key="{56ae7b77-608b-4746-8f82-785d387be19c}" symbol="1" filter="&quot;type_appareillage&quot; = 'ventouse'" label="ventouse"/>
              <rule key="{60287552-5009-4693-95c1-3d115a0cb36f}" symbol="2" filter="&quot;type_appareillage&quot; = 'disconnecteur'" label="disconnecteur"/>
              <rule key="{7df3616d-0133-4cbd-a5b1-f75783cf0db1}" symbol="3" filter="&quot;type_appareillage&quot; = 'filtre'" label="filtre"/>
              <rule key="{763353d8-d47b-4f97-bd97-2ae26b909487}" symbol="4" filter="&quot;type_appareillage&quot; = 'chasse'" label="chasse manuelle/automatique"/>
              <rule key="{d97ba98e-86f4-4927-8f0b-f2819eb1356c}" symbol="5" filter="&quot;type_appareillage&quot; = 'boite_boue'" label="boite à boues"/>
              <rule key="{d2117d11-92a9-40dc-80ec-72422f6d64ce}" symbol="6" filter="&quot;type_appareillage&quot; = 'purge'" label="purge"/>
              <rule key="{3a54b7f2-d26c-41a4-91e3-07cdeeaf7bac}" symbol="7" filter="&quot;type_appareillage&quot; = 'vidange'" label="vidange(décharge)"/>
              <rule key="{5c59240f-1b11-4f31-83f3-a47442f008af}" symbol="8" filter="&quot;type_appareillage&quot; = 'anti_belier'" label="anti-bélier"/>
              <rule key="{6eed5f2e-efff-4733-9f6e-48189690d889}" symbol="9" filter="&quot;type_appareillage&quot; = 'anti_retour'" label="Clapet anti retour"/>
            </rule>
          </rule>
          <rule key="{b8bb3ded-c04f-4985-8c5c-e8abc0617f48}" symbol="10" filter=" &quot;etat_service&quot; IN ('abandon','depose','comble')" label="Abandon"/>
          <rule key="{55bd9260-a539-449a-a5e4-0b7d3c3d3ef0}" symbol="11" filter=" &quot;etat_service&quot; IN ('projet','construction')" label="En projet/en construction"/>
          <rule key="{0ac6b1e2-ea91-430b-ab23-20d6c3abe7ff}" symbol="12" description="Manque de renseignement sur l'état de service" filter="ELSE" label="Etat non renseigné"/>
        </rules>
