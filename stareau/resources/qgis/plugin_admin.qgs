          <rule key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" description="Conduite en service ou arrêt momentané" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" label="En service">
            <rule scalemaxdenom="110000" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" symbol="0" scalemindenom="2001" label="Vue d'ensemble"/>
            <rule scalemaxdenom="2000" key="{12476d89-e51c-44f4-b989-88588868e278}" label="Détails">
              <rule key="{bae3c604-edbd-44fa-a1cc-50fc17085b1e}" symbol="1" filter="&quot;type_piece&quot; = 'cone'" label="Cône de réduction"/>
              <rule key="{cb5e0e3e-5f7b-4750-a5ec-267f1d3c6baa}" symbol="2" filter="&quot;type_piece&quot; = 'pp'" label="plaque pleine"/>
              <rule key="{48444f00-fb95-49e8-88a2-a778f9c356bb}" symbol="3" filter="&quot;type_piece&quot; = 'coude'" label="coude"/>
              <rule key="{ab08f032-7fd1-4283-9cb0-cb68d89434d2}" symbol="4" filter="&quot;type_piece&quot; = 'manchon'" label="manchon"/>
              <rule key="{fc85d01d-7d8d-461d-8326-62452cee1ad9}" symbol="5" filter="&quot;type_piece&quot; = 'raccord'" label="raccord"/>
              <rule key="{fcc63ae9-7051-4d27-9229-2efdc6cb98db}" symbol="6" filter="&quot;type_piece&quot; = 'te'" label="té"/>
              <rule key="{68e2a806-f9ec-4224-b6e4-8bc3deb45e6e}" symbol="7" filter="&quot;type_piece&quot; = 'bouchon'" label="bouchon"/>
            </rule>
          </rule>
