          <rule description="Conduite en service ou arrêt momentané" label="En service" key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')">
            <rule scalemaxdenom="110000" label="Vue d'ensemble" symbol="0" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" scalemindenom="2001"/>
