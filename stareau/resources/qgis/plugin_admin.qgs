          <rule filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" label="En service" description="Conduite en service ou arrêt momentané">
            <rule symbol="0" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" scalemaxdenom="110000" label="Vue d'ensemble" scalemindenom="2001"/>
            <rule key="{12476d89-e51c-44f4-b989-88588868e278}" scalemaxdenom="2000" label="Détails">
              <rule symbol="1" filter="&quot;type_piece&quot; = 'cone'" key="{bae3c604-edbd-44fa-a1cc-50fc17085b1e}" label="Cône de réduction"/>
              <rule symbol="2" filter="&quot;type_piece&quot; = 'pp'" key="{cb5e0e3e-5f7b-4750-a5ec-267f1d3c6baa}" label="plaque pleine"/>
