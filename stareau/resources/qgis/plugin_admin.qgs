              <rule label="regard borgne" symbol="1" key="{183d3d17-7daf-4c2e-b29e-886594ece2ba}" filter="&quot;type_regard&quot; = 'borgne'"/>
              <rule label="chambre" symbol="2" key="{f2e66d4f-c80d-4d27-82fe-07b2e74b481b}" filter="&quot;type_regard&quot; = 'chambre'"/>
              <rule label="regard de visite" symbol="3" key="{d806b8c0-9a0c-4cca-b75f-c9ff6bff8475}" filter="&quot;type_regard&quot; = 'visite'"/>
              <rule description="regard où passe eaux usées et pluviales sans se mélanger" label="regard mixte" symbol="4" key="{b92c459b-7f84-4572-b3c3-9fd0da5a431e}" filter="&quot;type_regard&quot; ='mixte'"/>
            </rule>
          </rule>
          <rule label="Abandon" symbol="5" key="{b8bb3ded-c04f-4985-8c5c-e8abc0617f48}" filter=" &quot;etat_service&quot; IN ('abandon','depose','comble')"/>
          <rule label="En projet/en construction" symbol="6" key="{55bd9260-a539-449a-a5e4-0b7d3c3d3ef0}" filter=" &quot;etat_service&quot; IN ('en_projet','en_construction')"/>
          <rule description="Manque de renseignement sur l'état de service" label="Etat non renseigné" symbol="7" key="{0ac6b1e2-ea91-430b-ab23-20d6c3abe7ff}" filter="ELSE"/>
        </rules>
