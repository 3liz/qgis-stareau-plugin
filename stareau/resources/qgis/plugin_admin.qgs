            <rule scalemaxdenom="2000" key="{12476d89-e51c-44f4-b989-88588868e278}" label="Détails">
              <rule key="{c22edb1c-5fdf-4886-8faa-32b734bcca68}" symbol="0" filter="&quot;type_raccord_branchement&quot; = 'culotte'" label="culotte"/>
              <rule key="{ae8eb162-978e-4db9-9615-8ac4587b6092}" symbol="1" filter="&quot;type_raccord_branchement&quot; = 'piquage_direct'" label="piquage direct"/>
              <rule key="{ed2f5a31-c085-456f-9750-77dc67f38102}" symbol="2" filter="&quot;type_raccord_branchement&quot; = 'selle'" label="selle"/>
              <rule key="{7b43a9b2-8394-4978-8931-ce67a9488d4d}" symbol="3" filter="&quot;type_raccord_branchement&quot; = 'te'" label="té"/>
              <rule key="{47470803-6782-4828-b917-aaac03740bdf}" symbol="4" filter="&quot;type_raccord_branchement&quot; = 'tulipe'" label="tulipe"/>
            </rule>
          </rule>
