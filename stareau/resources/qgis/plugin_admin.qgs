              <rule key="{b4fb8431-f846-4e1d-b03c-f108f950848f}" symbol="4" filter="&quot;type_pretraitement&quot; = 'separateur_hydrocarbure'" label="séparateur hydrocarbure"/>
              <rule key="{b4fb8431-f846-4e1d-b03c-f108f950848f}" symbol="5" filter="&quot;type_pretraitement&quot; = 'separateur_graisse'" label="séparateur à graisse"/>
