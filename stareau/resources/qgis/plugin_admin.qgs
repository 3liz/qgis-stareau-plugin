              </rule>
              <rule label="Pression" key="{fe36e0fc-98ea-4b98-a683-9a21fc1800a5}" filter="&quot;mode_circulation&quot; IN ('sous_vide','sous_pression')">
                <rule label="Eaux usées" symbol="4" key="{abdec9d5-cc0f-48db-a901-e900ef0f5091}" filter="&quot;type_reseau&quot; = 'assaeu'"/>
                <rule label="Eaux pluviales" symbol="5" key="{9c516794-b4d2-4c9c-bf74-f0e34dd2858c}" filter="&quot;type_reseau&quot; = 'assaep'"/>
                <rule label="Réseau Unitaire" symbol="6" key="{6e9a42a0-2a1e-4454-a7a5-8a92407a33bd}" filter="&quot;type_reseau&quot; = 'assaru'"/>
              </rule>
            </rule>
          </rule>
          <rule label="Réseau abandonné" symbol="7" key="{fd43441c-4976-4b24-8d3e-736b0eb4ab0f}" filter="&quot;etat_service&quot; IN ('abandon','comble','depose')"/>
          <rule label="Projet/construction" symbol="8" key="{4b6edb68-1654-450d-ac24-0d159dc80725}" filter="&quot;etat_service&quot; IN ('en_projet','en_construction')"/>
          <rule label="non renseigné" symbol="9" key="{8849f046-6255-4eda-8d66-0a19a66ca0d5}" filter="ELSE"/>
        </rules>
