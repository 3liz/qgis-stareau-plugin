              <rule symbol="4" filter="&quot;type_piece&quot; = 'manchon'" key="{ab08f032-7fd1-4283-9cb0-cb68d89434d2}" label="manchon"/>
              <rule symbol="5" filter="&quot;type_piece&quot; = 'raccord'" key="{fc85d01d-7d8d-461d-8326-62452cee1ad9}" label="raccord"/>
              <rule symbol="6" filter="&quot;type_piece&quot; = 'te'" key="{fcc63ae9-7051-4d27-9229-2efdc6cb98db}" label="té"/>
