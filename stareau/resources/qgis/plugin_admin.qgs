          <rule label="En service" key="{d6b2a60d-0a4c-49c4-b313-d346b1eaa481}" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')">
            <rule scalemaxdenom="110000" label="Vue d'ensemble" symbol="0" key="{60f082db-c42a-4f99-861f-afba2fdc7fe5}" scalemindenom="2001"/>
            <rule scalemaxdenom="2000" label="Réseau" key="{b825515c-5d10-42b0-a7c8-b1c3695f4928}">
              <rule label="Gravitaire" key="{0b512ad0-8f12-4a7d-907e-da3b812aeeb3}" filter="&quot;mode_circulation&quot;='gravitaire'">
                <rule label="Eau Potable" symbol="1" key="{a42dbf4c-6b85-44d5-98fd-32a0db9e3901}" filter="&quot;type_reseau&quot; = 'aep'"/>
                <rule label="Réseau incendie" symbol="2" key="{c242b6e8-568b-4fad-90d8-0129c0f61697}" filter="&quot;type_reseau&quot; = 'incen'"/>
                <rule symbol="3" key="{2c28476a-f63f-4d3e-994b-aeb350af3d8b}" filter="ELSE"/>
              </rule>
              <rule label="Pression" key="{1d32f1d7-0f67-48d1-9bc5-52b87c792e9d}" filter=" &quot;mode_circulation&quot; IN ('sous_pression','sous_vide')">
                <rule label="Eau potable" symbol="4" key="{483cb71d-5fdb-4f5f-acae-b013d5ceadf3}" filter="&quot;type_reseau&quot; = 'aep'"/>
                <rule label="Réseau incendie" symbol="5" key="{79df1e24-f44d-43a5-bae4-b45d2243fab1}" filter="&quot;type_reseau&quot; = 'incen'"/>
                <rule symbol="6" key="{9ccb8a14-5180-4140-83e9-760606acd23f}" filter="ELSE"/>
              </rule>
              <rule label="Réhabilité" symbol="7" key="{41efa792-da62-4413-b9d4-fa2ef222ff72}" filter="&quot;an_rehab_sup&quot; OR &quot;an_rehab_inf&quot; "/>
