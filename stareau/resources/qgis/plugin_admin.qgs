          <rule key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" description="Conduite en service ou arrêt momentané" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" label="En service">
            <rule scalemaxdenom="110000" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" symbol="0" scalemindenom="2001" label="Vue d'ensemble"/>
            <rule scalemaxdenom="2000" key="{12476d89-e51c-44f4-b989-88588868e278}" label="Détails">
              <rule key="{e470d01b-d822-4615-aeb6-1ef056d5e53a}" symbol="1" filter="&quot;fonction_point_mesure&quot; = 'achat'" label="Achat"/>
              <rule key="{be6aa03c-6a82-400e-87c5-232e57e18e44}" symbol="2" filter="&quot;fonction_point_mesure&quot; = 'vente'" label="Vente"/>
              <rule key="{5db51b53-58a1-43fb-9a6f-1f9297adbfa8}" symbol="3" filter="&quot;fonction_point_mesure&quot; = 'achat_vente'" label="Achat et vente"/>
              <rule key="{391dfb83-0f9e-4d9d-8723-0b941c78cd9a}" symbol="4" filter="&quot;fonction_point_mesure&quot; = 'import'" label="Import (sans achat)"/>
              <rule key="{030993c1-0e94-4e06-ab4b-14fd19870c0d}" symbol="5" filter="&quot;fonction_point_mesure&quot; = 'export'" label="Export (sans vente)"/>
              <rule key="{62dababf-f3e6-486d-a899-9272a110ede1}" symbol="6" filter="&quot;fonction_point_mesure&quot; = 'sectorisation'" label="Sectorisation"/>
              <rule key="{2b3cdb94-99fc-44c3-877b-9019f0b9b071}" symbol="7" filter="&quot;fonction_point_mesure&quot; = 'recherche_fuite'" label="Recherche de fuite (permanent ou ponctuel)"/>
            </rule>
          </rule>
          <rule key="{b8bb3ded-c04f-4985-8c5c-e8abc0617f48}" symbol="8" filter=" &quot;etat_service&quot; IN ('abandon','depose','comble')" label="Abandon"/>
          <rule key="{55bd9260-a539-449a-a5e4-0b7d3c3d3ef0}" symbol="9" filter=" &quot;etat_service&quot; IN ('projet','construction')" label="En projet/en construction"/>
          <rule key="{0ac6b1e2-ea91-430b-ab23-20d6c3abe7ff}" symbol="10" description="Manque de renseignement sur l'état de service" filter="ELSE" label="Etat non renseigné"/>
        </rules>
