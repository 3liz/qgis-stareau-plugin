          <rule key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" description="Conduite en service ou arrêt momentané" filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" label="En service">
            <rule scalemaxdenom="110000" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" scalemindenom="2001" label="Vue d'ensemble"/>
            <rule scalemaxdenom="2000" key="{12476d89-e51c-44f4-b989-88588868e278}" label="Détails">
              <rule key="{9a39fed9-380d-4366-922e-b603b74bcb47}" symbol="0" filter="&quot;type_piece&quot; = 'bouchon'" label="bouchon"/>
              <rule key="{6c22ecb4-ca47-48ba-b742-a6de2a50d680}" symbol="1" filter="&quot;type_piece&quot; = 'coude'" label="coude"/>
              <rule key="{6c22ecb4-ca47-48ba-b742-a6de2a50d680}" symbol="2" filter="&quot;type_piece&quot; = 'manchon'" label="manchon"/>
              <rule key="{6c22ecb4-ca47-48ba-b742-a6de2a50d680}" symbol="3" filter="&quot;type_piece&quot; = 'raccord'" label="raccord"/>
              <rule key="{6c22ecb4-ca47-48ba-b742-a6de2a50d680}" symbol="4" filter="&quot;type_piece&quot; = 'te'" label="té"/>
              <rule key="{6c22ecb4-ca47-48ba-b742-a6de2a50d680}" symbol="5" filter="&quot;type_piece&quot; = 'cone'" label="cône de réduction"/>
            </rule>
          </rule>
          <rule key="{b8bb3ded-c04f-4985-8c5c-e8abc0617f48}" symbol="6" filter=" &quot;etat_service&quot; IN ('abandon','depose','comble')" label="Abandon"/>
          <rule key="{55bd9260-a539-449a-a5e4-0b7d3c3d3ef0}" symbol="7" filter=" &quot;etat_service&quot; IN ('en_projet','en_construction')" label="En projet/en construction"/>
          <rule key="{0ac6b1e2-ea91-430b-ab23-20d6c3abe7ff}" symbol="8" description="Manque de renseignement sur l'état de service" filter="ELSE" label="Etat non renseigné"/>
        </rules>
