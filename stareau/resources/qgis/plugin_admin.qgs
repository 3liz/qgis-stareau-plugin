          <rule filter="&quot;etat_service&quot; IN ( 'en_service','en_arret')" key="{8db5a71e-f629-4bf3-aaa2-a27dfc009365}" label="En service" description="Conduite en service ou arrêt momentané">
            <rule symbol="0" key="{ca9712c6-fd75-4bab-b2e7-f56a84e21d68}" scalemaxdenom="110000" label="Vue d'ensemble" scalemindenom="2001"/>
            <rule key="{12476d89-e51c-44f4-b989-88588868e278}" scalemaxdenom="2000" label="Détails">
              <rule symbol="1" filter="&quot;type_chambre_depollution&quot; = 'simple'" key="{de6b7539-90f8-4966-8983-4360402bde68}" label="simple"/>
              <rule symbol="2" filter="&quot;type_chambre_depollution&quot; = 'double'" key="{af381318-fd2d-4183-8945-68eafe448644}" label="double"/>
              <rule symbol="3" filter="&quot;type_chambre_depollution&quot; = 'triple'" key="{af381318-fd2d-4183-8945-68eafe448644}" label="triple"/>
              <rule symbol="4" filter="&quot;type_chambre_depollution&quot; = 'multiple'" key="{af381318-fd2d-4183-8945-68eafe448644}" label="multiple"/>
            </rule>
          </rule>
          <rule symbol="5" filter=" &quot;etat_service&quot; IN ('abandon','depose','comble')" key="{b8bb3ded-c04f-4985-8c5c-e8abc0617f48}" label="Abandon"/>
          <rule symbol="6" filter=" &quot;etat_service&quot; IN ('en_projet','en_construction')" key="{55bd9260-a539-449a-a5e4-0b7d3c3d3ef0}" label="En projet/en construction"/>
